NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:8080

# ForgePass WebAuthn relying party. Production must set every value except the
# timeout, use HTTPS origins, and keep origins within the RP ID domain.
WEBAUTHN_RP_NAME=ForgePass
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGINS=http://localhost:3000
WEBAUTHN_TIMEOUT_MS=60000
# One-time ceremony challenges expire after 60-600 seconds.
WEBAUTHN_CHALLENGE_TTL_SECONDS=300
# ForgePass virtual authenticator AAGUID(s), normalized to lowercase hex.
WEBAUTHN_ALLOWED_AAGUIDS=ccac9302f70b5904a2823658e8bca0a6

DATABASE_URL=postgres://postgres:postgres@localhost:5432/comms
REDIS_URL=redis://localhost:6379

JWT_SECRET=replace_me_with_long_random

# Providers (later)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

SENDGRID_API_KEY=
# SendGrid Event Webhook public key. PEM (with escaped \n) is preferred.
SENDGRID_EVENT_WEBHOOK_PUBLIC_KEY=
# Backward-compatible option for the base64-encoded SPKI DER public key.
SENDGRID_EVENT_WEBHOOK_PUBLIC_KEY_BASE64=
# Optional but recommended: the SendGrid Unsubscribe Group ID created for
# commercial referral invitations. Do not reuse it for account/security mail.
SENDGRID_REFERRAL_UNSUBSCRIBE_GROUP_ID=
# Full production setup and verification: SENDGRID_LAUNCH.md

# SendGrid sender addresses
# Keep account mail on the sender proven by the cross-test until another
# authenticated identity is independently validated.
ACCOUNT_FROM_EMAIL=referrals@sendforge.app
ACCOUNT_FROM_NAME=SendForge
REFERRAL_FROM_EMAIL=referrals@sendforge.app
REFERRAL_FROM_NAME=SendForge Rewards
# Required before commercial referral mail can send. Use the business street
# address, a registered USPS PO box, or a registered commercial mailbox.
REFERRAL_BUSINESS_ADDRESS=SendForge LLC, 6749 Fulton St E, Ste A #2333, Ada, MI 49301
PRIVACY_POLICY_URL=https://sendforge.app/privacy.html
SUPPORT_EMAIL=support@sendforge.app
VERIFY_FROM_EMAIL=referrals@sendforge.app
SENDGRID_FROM_EMAIL=referrals@sendforge.app
SENDGRID_FROM_NAME=SendForge
CONTACT_FROM_EMAIL=referrals@sendforge.app
CONTACT_FROM_NAME=SendForge
CONTACT_TO_EMAIL=support@sendforge.app

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stable Stripe Price IDs are recommended. The backend has launch-safe inline
# $10 one-time / $5 monthly fallbacks when these are blank.
STRIPE_PRICE_TABFORGE=
STRIPE_PRICE_TABFORGE_SYNC=

# Other billing channels (later)
APPLE_ENV=SANDBOX
GOOGLE_PLAY_ENABLED=true
STRIPE_ENABLED=true

# Admin console (backend-gated; desktop app should never connect directly to Postgres)
ADMIN_ALLOWED_EMAILS=admin@example.com
ADMIN_MFA_EMAIL=admin@example.com
ADMIN_WRITES_ENABLED=true
ADMIN_FROM_EMAIL=referrals@sendforge.app
ADMIN_FROM_NAME=SendForge Admin
