NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:8080

DATABASE_URL=postgres://postgres:postgres@localhost:5432/comms
REDIS_URL=redis://localhost:6379

JWT_SECRET=replace_me_with_long_random

# Providers (later)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

SENDGRID_API_KEY=
# SendGrid Event Webhook public key. PEM (with escaped \n) is preferred.
SENDGRID_EVENT_WEBHOOK_PUBLIC_KEY=
# Backward-compatible option for the base64-encoded SPKI DER public key.
SENDGRID_EVENT_WEBHOOK_PUBLIC_KEY_BASE64=
# Optional but recommended: the SendGrid Unsubscribe Group ID created for
# commercial referral invitations. Do not reuse it for account/security mail.
SENDGRID_REFERRAL_UNSUBSCRIBE_GROUP_ID=
# Full production setup and verification: SENDGRID_LAUNCH.md

# SendGrid sender addresses
# Keep account mail on the sender proven by the cross-test until another
# authenticated identity is independently validated.
ACCOUNT_FROM_EMAIL=referrals@sendforge.app
ACCOUNT_FROM_NAME=SendForge
REFERRAL_FROM_EMAIL=referrals@sendforge.app
REFERRAL_FROM_NAME=SendForge Rewards
# Required before commercial referral mail can send. Use the business street
# address, a registered USPS PO box, or a registered commercial mailbox.
REFERRAL_BUSINESS_ADDRESS=SendForge LLC, 6749 Fulton St E, Ste A #2333, Ada, MI 49301
PRIVACY_POLICY_URL=https://sendforge.app/privacy.html
SUPPORT_EMAIL=support@sendforge.app
VERIFY_FROM_EMAIL=referrals@sendforge.app
SENDGRID_FROM_EMAIL=referrals@sendforge.app
SENDGRID_FROM_NAME=SendForge
CONTACT_FROM_EMAIL=referrals@sendforge.app
CONTACT_FROM_NAME=SendForge
CONTACT_TO_EMAIL=support@sendforge.app

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stable Stripe Price IDs are recommended. The backend has launch-safe inline
# $10 one-time / $5 monthly fallbacks when these are blank.
STRIPE_PRICE_TABFORGE=
STRIPE_PRICE_TABFORGE_SYNC=
STRIPE_PRICE_FORGEDROP=
# ForgeDrop Cloud pickup: one monthly recurring Price per tier ($5, $10, $15,
# $25 for 100 GB, 250 GB, 500 GB, 1 TB sent a month). No inline fallback: a
# tier whose id is blank is not on sale (checkout answers 503 plan_unavailable),
# and the webhook knows a subscription's tier by these ids. To let customers
# switch tiers, list all four prices under the customer portal's "Customers can
# switch plans" in Stripe; until then a switch opens the portal's front page.
STRIPE_PRICE_FORGEDROP_PICKUP_100GB=
STRIPE_PRICE_FORGEDROP_PICKUP_250GB=
STRIPE_PRICE_FORGEDROP_PICKUP_500GB=
STRIPE_PRICE_FORGEDROP_PICKUP_1TB=

# Offline device licences (ForgeDrop, Rose Colored Glasses).
#
# A 32-byte Ed25519 seed, base64 or hex:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# One key signs every licensed product; the product name is inside the signed
# licence, so one product's licence never opens another.
#
# Installed apps verify licences against the matching public key compiled into
# them and never call back, so treat this like a code-signing key: losing it
# means reissuing every licence, and leaking it cannot be fixed server-side.
# Without it, activation returns 503 rather than failing obscurely.
#
# The older FORGEDROP_LICENSE_SIGNING_KEY / _KID names are still read when
# these are blank.
LICENSE_SIGNING_KEY=
LICENSE_SIGNING_KID=

# Romancing the Stone (src/modules/romancing-the-stone, see romancing-the-stone.md).
# Every /v1/rts route answers 503 and its two catalog products cannot be bought
# until this is true. Prices are built into the module; no Stripe price ids.
RTS_ENABLED=false
# Where Stripe sends buyers back to. Blank = PUBLIC_SITE_URL/romancing-the-stone/
RTS_APP_URL=
# Accounts with a complimentary licence, comma separated. Unset falls back to the
# TabForge owner address; set it to an empty value to give none.
RTS_COMP_EMAILS=

# Other billing channels (later)
APPLE_ENV=SANDBOX
GOOGLE_PLAY_ENABLED=true
STRIPE_ENABLED=true

# Admin console (backend-gated; desktop app should never connect directly to Postgres)
ADMIN_ALLOWED_EMAILS=admin@example.com
ADMIN_MFA_EMAIL=admin@example.com
ADMIN_WRITES_ENABLED=true
ADMIN_FROM_EMAIL=referrals@sendforge.app
ADMIN_FROM_NAME=SendForge Admin

# Google sign-in and Google Contacts import share one OAuth client.
# Add the openid, email, and profile scopes to it for sign-in, and register
# https://sendforge.app as an authorized JavaScript origin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
