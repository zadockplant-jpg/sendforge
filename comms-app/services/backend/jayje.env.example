# Add these to the EXISTING SendForge Render service. No change to .env is shipped.
# Keep false until the deployed migration and email routing have been checked.
JAYJE_ENABLED=false
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the SAME value in Render and the JayJe Cloudflare Pages secret.
JAYJE_PROXY_SECRET=
JAYJE_ALLOWED_ORIGINS=https://jayje.com,https://www.jayje.com
# Explicit JayJe notification inbox. Do not leave blank when enabling the form.
JAYJE_CONTACT_TO_EMAIL=
# Optional: a SendGrid-verified sender. Blank reuses CONTACT_FROM_EMAIL,
# ACCOUNT_FROM_EMAIL or SENDGRID_FROM_EMAIL, without changing their values.
JAYJE_FROM_EMAIL=
JAYJE_FROM_NAME=JayJe service requests
# Reuses existing DATABASE_URL, REDIS_URL and SENDGRID_API_KEY.
