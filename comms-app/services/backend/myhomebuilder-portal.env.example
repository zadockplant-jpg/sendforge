# My Home Builder client portal (see myhomebuilder-portal.md). Set these on the Render
# web service. The module answers 503 until MHB_PORTAL_ENABLED=true.
MHB_PORTAL_ENABLED=false
# Shared with the myhomebuilderllc.com Pages Function; at least 32 random characters.
MHB_PROXY_SECRET=
# Signs portal session cookies; at least 32 random characters.
MHB_SESSION_SECRET=
# The Muskegon Addition client's project login.
MHB_CLIENT_PORTAL_PASSWORD=
# My Home Builder LLC's own Stripe account (not STRIPE_SECRET_KEY) and the signing secret of
# https://comms-app-1wo0.onrender.com/v1/myhomebuilder/portal/stripe/webhook
MHB_STRIPE_SECRET_KEY=
MHB_STRIPE_WEBHOOK_SECRET=
# Optional. Email reuses SENDGRID_API_KEY; mail goes from billing@myhomebuilderllc.com.
MHB_SITE_URL=https://myhomebuilderllc.com
MHB_ADMIN_EMAIL=mb@myhomebuilderllc.com
